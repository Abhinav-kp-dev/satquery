# Copy to .env to configure the backend.

# Narration backend. Numbers never come from it -- every figure is measured by
# the deterministic tools and checked by the adjudicator.
#   mock           offline template narrator (default, no credentials)
#   openai_compat  self-hosted open-weight VLM (Qwen2.5-VL on vLLM) with
#                  per-task LoRA adapters -- see training/README.md
#   anthropic      Claude
SATQUERY_VLM_PROVIDER=mock

SATQUERY_VLM_BASE_URL=http://127.0.0.1:8001
SATQUERY_VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
SATQUERY_VLM_USE_ADAPTERS=true

SATQUERY_ANTHROPIC_API_KEY=
SATQUERY_ANTHROPIC_MODEL=claude-sonnet-5

# Scenes larger than this on either side are analysed on a decimated grid.
SATQUERY_ANALYSIS_MAX_DIM=1536
